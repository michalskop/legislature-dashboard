# Supabase (shared project with pollster-2026/mandaty.cz) — not currently
# read by any code in this app (same as cz-psp); kept for future parity.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
